{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    // Not used by src. bun test applies this file to apps/api's app.tsx when the
    // e2e test loads the in-memory API, so it must match apps/api/tsconfig.json.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src"]
}

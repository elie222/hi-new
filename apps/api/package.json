    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "harfbuzzjs": "0.10.0",
    "hono": "4.13.5",
    "mppx": "0.9.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satori": "0.33.4",
    "stripe": "22.6.1"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",

---
import "@hi-new/ui/tokens.css";
import "../styles/base.css";
import "../styles/setup.css";
import { Footer, Nav, NAV_CSS } from "@hi-new/ui";

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:global set:html={NAV_CSS}></style>
  </head>
  <body>
    <Nav />

    <slot />

    <Footer
      className="landing-footer"
      showWordmark
      links={[
        { href: "/#faq", label: "FAQ" },
        { href: "https://rakazo.com", label: "Rakazo" },
        { href: "https://botdirectory.ai", label: "Bot Directory" },
      ]}
    />

  </body>
</html>
